    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
if (!System.IO.File.Exists(ManifestFile))
{
string content = @"{
  ""name"": """ + AssemblyName + @""",
  ""version_number"": ""1.0.0"",
  ""website_url"": ""https://github.com/JoksterCube/PingMark"",
